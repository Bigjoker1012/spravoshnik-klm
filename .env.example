# Название компании (отображается в заголовке и на экране входа)
COMPANY_NAME=МояКомпания

# Ссылка на Google Таблицу с данными сотрудников
# Формат: https://docs.google.com/spreadsheets/d/ВАШ_ID/export?format=csv
SHEET_URL=https://docs.google.com/spreadsheets/d/ВСТАВЬТЕ_ID_ТАБЛИЦЫ/export?format=csv

# Пароль для входа в приложение
APP_PASSWORD=ваш_пароль

# Секрет для шифрования сессий (любая случайная строка, минимум 16 символов)
SESSION_SECRET=случайная_строка_минимум_16_символов
